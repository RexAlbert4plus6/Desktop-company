{
  "name": "kairos-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "A Windows desktop companion with local chat and editable memory",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "postpackage": "node scripts/prepare-character-folders.cjs",
    "source": "node scripts/prepare-public-source.cjs",
    "package": "electron-packager . KairosDesktop --platform=win32 --arch=x64 --out=dist/v0.5.0 --overwrite --ignore=^/dist --ignore=^/test --ignore=^/private --ignore=^/character --ignore=^/release --ignore=^/runtime-data --ignore=^/.git --ignore=lnk$"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.2"
  }
}
